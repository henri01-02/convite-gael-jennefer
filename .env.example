# Copie este arquivo para .env e preencha com os dados do painel Meta.
# Nunca publique o arquivo .env no GitHub.
WHATSAPP_ACCESS_TOKEN=COLOQUE_SEU_TOKEN
WHATSAPP_PHONE_NUMBER_ID=COLOQUE_O_ID_DO_NUMERO
WEBHOOK_VERIFY_TOKEN=crie_uma_palavra_secreta
# Informe a versão atual da Graph API exibida na documentação/painel da Meta.
WHATSAPP_API_VERSION=vXX.X
PORT=3000
